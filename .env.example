# Copia este archivo a .env.local (igual que en Next.js)
# npm start ejecuta sync-env y genera src/environments/environment.ts

# --- Firebase (públicas en el cliente) ---
FIREBASE_API_KEY=tu_api_key
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_APP_ID=1:123456789:web:abcdef
# Opcionales (recomendados si aparecen en la consola de Firebase):
# FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
# FIREBASE_MESSAGING_SENDER_ID=123456789

# --- Backend chatbot (desarrollo) ---
WEBSOCKET_URL=wss://URL_DEV/ws/query
API_KEY=API_KEY_DEV

# --- Solo scripts Node (NO se sincronizan a Angular) ---
# Ruta al JSON de cuenta de servicio de Firebase (para npm run i18n:push)
# Ver docs/CONFIGURACION_FIREBASE.md paso 7
FIREBASE_SERVICE_ACCOUNT_PATH=./tu-proyecto-firebase-adminsdk-xxxxx.json
